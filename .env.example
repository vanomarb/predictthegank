PORT=3000
NODE_ENV=production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Supabase project settings -> Database -> Connection string -> "Transaction" mode
# (pooled, port 6543). Using the pooler avoids exhausting Postgres connections
# when the app runs as many short-lived serverless function instances.
SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# IANA timezone the team is in (e.g. America/New_York, Europe/London). Used to
# bucket the heatmap into the right local day/hour regardless of where the
# server itself runs. Defaults to UTC if unset.
TIMEZONE=UTC

# When the "log a sighting" buttons are clickable, on the TIMEZONE clock above.
# Hours are 24h, start inclusive, end exclusive (9-18 = live 09:00, dead 18:00).
# WORK_DAYS accepts "1-5" or "1,2,3,4,5"; 0 is Sunday. Defaults: Mon-Fri, 9-18.
WORK_HOURS_START=9
WORK_HOURS_END=18
WORK_DAYS=1-5

# Testing only: force the countdown to start at this many milliseconds and tick
# down from there, so the last-minute behaviour (red urgent pulse at 60s, the
# 1-minute and 30-second alerts) can be checked without waiting for a real
# window. 65000 gives a 1:05 countdown, which crosses both alert thresholds.
# Both pages show an "override" badge while it is set, and the server logs a
# warning at boot. Reload the page to run the countdown again. Leave unset in
# production — the displayed countdown is fabricated while this is on.
# COUNTDOWN_OVERRIDE_MS=65000

# Optional: set to enable the Gemini-refined "smart" prediction on top of the
# built-in statistical one. Leave unset to run on the statistical prediction only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
